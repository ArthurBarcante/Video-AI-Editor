APP_ENV=development
DEBUG=true

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CODEC=pcm_s16le
AUDIO_TEST_DURATION=60
AUDIO_FAST_TEST_MODE=false
AUDIO_CREATE_CHUNKS=true
AUDIO_CHUNK_DURATION=900
AUDIO_CHUNK_OVERLAP=2

WHISPER_PROFILE=fast

WHISPER_WORD_TIMESTAMPS=false
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=0
WHISPER_BEST_OF=0
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
TRANSCRIPTION_USE_CHUNKS=true
TRANSCRIPTION_CHUNK_DURATION=900
TRANSCRIPTION_CHUNK_OVERLAP=2
TRANSCRIPTION_CHUNK_WORKERS=1
TRANSCRIPTION_CHUNKS_PARALLEL=false

SHORT_MIN_DURATION=15
SHORT_MAX_DURATION=45
SHORTS_RENDER_PROFILE=fast
SHORTS_RENDER_WORKERS=2
SHORTS_RENDER_PARALLEL=true

LONG_VIDEO_MIN_DURATION=1200
LONG_VIDEO_MAX_DURATION=1800
LONG_RENDER_PROFILE=fast
LONG_RENDER_PARALLEL=true
LONG_RENDER_WORKERS=2
LONG_AUDIO_COPY=false

MAX_SHORTS=5
MAX_LONG_VIDEOS=1

VIDEO_OUTPUT_FORMAT=mp4
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
VERTICAL_RENDER_PROFILE=fast
VERTICAL_RENDER_WORKERS=2
VERTICAL_RENDER_PARALLEL=true
VERTICAL_BLUR_ENABLED=true
VERTICAL_FAST_MODE=false
VERTICAL_FAST_WIDTH=540
VERTICAL_FAST_HEIGHT=960

HIGHLIGHT_MIN_SCORE=0.40

LOG_LEVEL=INFO
